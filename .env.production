# =====================================================================
#  WARI NIOUMA — Configuration de PRODUCTION (LWS)
#  → Sur le serveur : copiez ce fichier en « .env » puis remplissez les
#    valeurs marquées A_REMPLIR. Générez la clé avec :  php artisan key:generate
#  ⚠ Ne jamais committer le .env rempli (secrets).
# =====================================================================

APP_NAME="WARI NIOUMA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://VOTRE-DOMAINE.com

APP_TIMEZONE=Africa/Bamako
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# Journaux : en production on garde uniquement les erreurs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Base de données MySQL LWS (à créer dans le panneau LWS) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=A_REMPLIR_nom_base
DB_USERNAME=A_REMPLIR_utilisateur
DB_PASSWORD=A_REMPLIR_mot_de_passe

# --- Sessions / cache / files : stockés en base MySQL (aucun service externe) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- E-mail : l'app n'envoie pas d'e-mail (connexion par téléphone).
#     On laisse « log ». Mettez du SMTP LWS seulement si besoin plus tard. ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@VOTRE-DOMAINE.com"
MAIL_FROM_NAME="${APP_NAME}"

# Broadcast/Redis/AWS : non utilisés
BROADCAST_CONNECTION=log
